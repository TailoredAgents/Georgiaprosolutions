# Preview is the safe default. It discards estimate data and never sends emails.
SITE_MODE=preview
SITE_URL=http://localhost:43187
ALLOW_INDEXING=false

# Run npm run admin:setup to create ignored .env.local with salted hash and secret.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Production persistence. Not required for the public preview or sample dashboard.
DATABASE_URL=
# Use true for external TLS connections; use false for Render internal/private DB.
DATABASE_SSL=false
# Optional custom trusted CA, PEM with literal \n separators.
DATABASE_CA=
# Enable only behind a reverse proxy that overwrites forwarded client IP headers.
TRUST_PROXY=false

# Both must be true for collection (server AND client build-time flag).
# Preview always ignores event collection, even if enabled accidentally.
ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_ENABLED=false
ANALYTICS_RETENTION_DAYS=90
INQUIRY_RETENTION_DAYS=365

# Optional Resend notification; requires a verified sending domain.
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=

# Schema is emitted only for owner-approved business details in production.
BUSINESS_DETAILS_APPROVED=false
